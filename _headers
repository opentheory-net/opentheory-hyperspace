# Serve beside index.html, not from a public/ directory or invented build.
# The script hash covers the unchanged inline script; styles remain inline.
# Google Fonts and the data-URI grain image are required by the authored page.
/*
  Content-Security-Policy: default-src 'self'; script-src 'sha256-ATnbNy+4DA7q3Wa7JdYydYWM0jGdnTFCF4YPEoKHj3w='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
